  addressLabel:   { fontSize: 13, marginTop: 1 },
  addressText:    { color: 'rgba(255,255,255,0.7)', fontSize: 13, flex: 1, lineHeight: 18 },
  addressDivider: { height: 1, backgroundColor: 'rgba(255,255,255,0.06)', marginVertical: 8, marginLeft: 22 },

          <AlertTriangle size={18} className="text-red-400 shrink-0 mt-0.5" />
          <div>
            <p className="text-red-300 text-sm font-semibold mb-0.5">{alertCount} producto{alertCount > 1 ? 's' : ''} requieren atención</p>

  // Show user-friendly message
  showError(printError.message)
  
  // Check if retryable
  if (printError.retryable) {
    showRetryOption()
  }
  
  // Show suggestions
  printError.suggestions?.forEach(suggestion => {
    showSuggestion(suggestion)
  })
}

  'av vitacura':            'Vitacura',

  // ── Línea 2 / 3 ───────────────────────────────────────────────────────────
  'irarrazaval':            'Ñuñoa',
  'metro irarrazaval':      'Ñuñoa',
  'metro nunoa':            'Ñuñoa',

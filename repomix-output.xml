 */
export function createPrintContext(
  restaurantId: string,
  orderId: string,
  tableId: string,
  documentType: DocumentType | string,
  userId?: string
): PrintContext {
  return {
    restaurantId,
    orderId,
    tableId,
    documentType: documentType as DocumentType,
    userId
  }
}


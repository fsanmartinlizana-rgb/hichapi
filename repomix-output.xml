/** Pedidos delivery con tracking activo */
export const ACTIVE_DELIVERY_STATUSES = new Set([
  'pending_assignment',
  'assigned',
  'picked_up',
  'in_transit',
])

export function isActiveDelivery(status: string): boolean {
  return ACTIVE_DELIVERY_STATUSES.has(status)
}


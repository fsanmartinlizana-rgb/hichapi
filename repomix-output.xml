              <View style={styles.timeField}>
                <Text style={styles.fieldLabel}>Fin</Text>
                <TextInput style={styles.fieldInput} value={endTime} onChangeText={setEndTime} placeholder="18:00" accessibilityLabel="Hora de fin" />

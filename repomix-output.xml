      SELECT 1 FROM team_members tm
      WHERE tm.restaurant_id = dte_receptores.restaurant_id
        AND tm.user_id = auth.uid()
        AND tm.active = true
        AND tm.role IN ('owner', 'admin', 'supervisor', 'cajero')

    borderRadius: 12,
    paddingVertical: 14,
    alignItems: 'center',
  },
  billButtonText: { color: '#fff', fontSize: 15, fontWeight: '700' },
  cartBar: {
    position: 'absolute',
    bottom: 0,
    left: 0,
    right: 0,
    backgroundColor: '#1F2937',

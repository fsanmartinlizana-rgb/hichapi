              ? 'w-2.5 h-2.5 bg-white/15'
              : i === position - 1
              ? 'w-4 h-4 bg-[#FF6B35] ring-2 ring-[#FF6B35]/30'
              : 'w-2 h-2 bg-white/6'
          }`}
        />
      ))}
      {position > show && (
        <span className="text-white/20 text-xs">+{position - show}</span>

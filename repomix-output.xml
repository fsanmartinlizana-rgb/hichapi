CREATE TABLE IF NOT EXISTS nps_responses (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id       UUID REFERENCES auth.users(id),
  restaurant_id UUID REFERENCES restaurants(id),

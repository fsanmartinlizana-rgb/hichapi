      <TouchableOpacity
        style={[customerStyles.btnOutline, { marginTop: 12 }]}
        onPress={() => navigation.navigate('CustomerSettings')}
      >
        <Text style={customerStyles.btnOutlineText}>Configuración →</Text>
      </TouchableOpacity>
    </ScrollView>
  )
}

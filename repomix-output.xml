  const { data: cafRow } = await supabase
    .from('dte_cafs')
    .select('xml_ciphertext, xml_iv, xml_auth_tag')
    .eq('id', caf_id)
    .single()

  if (!cafRow) {
    console.error('❌ No se pudo cargar el CAF')

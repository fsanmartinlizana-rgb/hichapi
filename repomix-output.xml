          </div>
          <span
            className="shrink-0 flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold"
            style={{ backgroundColor: `${tone.color}1a`, border: `1px solid ${tone.color}40`, color: tone.color }}
          >
            {score.total} / 100
          </span>

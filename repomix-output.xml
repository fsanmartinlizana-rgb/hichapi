        })
      )

      consoleSpy.mockRestore()
    })

    it('includes timestamp in log entry', () => {
      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {})

      const error: PrintError = {
        type: 'printer_error',
        message: 'Printer error',
        retryable: true,
      }

      const context: PrintContext = {

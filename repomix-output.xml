          expect(rating.created_at).toMatch(/^\d{4}-\d{2}-\d{2}T/)
        }),
        { numRuns: 100 }
      )
    })
  })

  describe('arbLoyaltyTransaction', () => {
    it('generates valid LoyaltyTransaction objects', () => {
      fc.assert(

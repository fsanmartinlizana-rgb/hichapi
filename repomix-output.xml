        <button onClick={reset} className="flex items-center gap-2 px-4 py-2 text-sm bg-white/10 text-white rounded-lg hover:bg-white/15 transition-colors">
          <Upload size={14} />Importar otro archivo
        </button>
      </div>
    )
  }

  return (

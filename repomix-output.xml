                ${f.complete
                  ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400/80'
                  : 'bg-white/3 border-white/8 text-white/30'}`}
            >
              {f.complete
                ? <Check size={9} strokeWidth={3} />
                : <span className="text-white/20 text-[9px] font-bold leading-none">✗</span>}
              {f.label}
            </span>
          ))}
        </div>
      </div>
    </div>
  )
}


  });
});

// ---------------------------------------------------------------------------
// 8. onPress callback
// ---------------------------------------------------------------------------

describe('TableCard — onPress callback', () => {
  it('calls onPress when card is tapped', () => {
    const onPress = jest.fn();
    const table = buildTable({ label: 'Mesa 5' });
    const { getAllByRole } = render(
      <TableCard table={table} onPress={onPress} />
